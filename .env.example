# 복사해서 .env 로 만든다.  cp .env.example .env
# .env 는 git 에 올리지 않는다. VITE_ 로 시작하는 값은 브라우저에 그대로 노출되므로 비밀값을 넣지 않는다.

# BE 주소. 비워 두면 같은 출처(/api)로 요청하고, 개발 서버(vite)가 VITE_PROXY_TARGET 으로 넘겨 준다.
# 배포(Vercel 등)에서는 BE 의 공개 주소를 넣는다. 예: https://xxxx.trycloudflare.com
VITE_API_BASE_URL=

# 개발 서버가 /api 를 넘겨 줄 BE 주소. 팀원이 내 PC 의 BE 를 쓸 때는 내 PC 주소로 바꾼다.
VITE_PROXY_TARGET=http://localhost:8080

# true 면 BE 없이 MSW 목업으로 동작한다. (src/mocks/handlers.ts)
VITE_USE_MOCK=false
