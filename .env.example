# 복사해서 .env 로 만든다.  cp .env.example .env
# .env 는 git 에 올리지 않는다. VITE_ 로 시작하는 값은 브라우저에 그대로 노출되므로 비밀값을 넣지 않는다.

# BE 주소. 비워 두면 같은 출처(/api)로 요청하고, 개발 서버(vite)가 VITE_PROXY_TARGET 으로 넘겨 준다.
# 배포(Vercel 등)에서는 BE 의 공개 https 주소 앞부분만 넣는다(끝 슬래시·/api 없음). 예: https://xxxx.trycloudflare.com
# Vite 는 이 값을 빌드할 때 박는다. Vercel 환경변수를 바꾼 뒤에는 반드시 Redeploy 한다. 비어 있으면 배포본의 API 요청이 전부 실패한다.
VITE_API_BASE_URL=

# 개발 서버가 /api 를 넘겨 줄 BE 주소. 팀원이 내 PC 의 BE 를 쓸 때는 내 PC 주소로 바꾼다.
VITE_PROXY_TARGET=http://localhost:8080

# true 면 BE 없이 MSW 목업으로 동작한다. (src/mocks/handlers.ts)
VITE_USE_MOCK=false

# 학교 Google 로그인용 OAuth 클라이언트 ID. 팀에게 받아서 .env 에 넣는다. (브라우저에 공개되는 값이라 비밀값은 아니다)
# 이 클라이언트의 "승인된 JavaScript 출처"에 http://localhost:5173 이 등록돼 있어야 로그인 창이 열린다.
# 배포(Vercel)에도 같은 값을 환경변수로 넣고, 배포 주소(https://raising-mari.vercel.app)도 승인된 출처에 추가한다.
VITE_GOOGLE_CLIENT_ID=
